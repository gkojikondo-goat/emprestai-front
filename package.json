{
  "name": "emprestai-front",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Front do sistema de emprestimo de equipamentos internos",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sync:api": "node -e \"require('fs').copyFileSync('../emprestai-api/openapi.json','openapi.json')\"",
    "gen:api": "orval",
    "check:api": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.0",
    "orval": "^8.47.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
